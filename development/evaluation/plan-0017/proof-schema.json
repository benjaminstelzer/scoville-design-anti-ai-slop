{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PLAN-0017 evaluator relationship proof",
  "type": "object",
  "required": ["artifact", "relation", "visual", "measurement", "verdict"],
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "laneStatus": {"enum": ["pass", "fail", "unverified", "not-applicable"]},
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "source_hash", "render_hash", "viewport"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "source_hash": {"$ref": "#/$defs/hash"},
        "render_hash": {"$ref": "#/$defs/hash"},
        "viewport": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2}
      }
    }
  },
  "properties": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["source_hash", "render_hash", "viewport"],
      "properties": {
        "source_hash": {"$ref": "#/$defs/hash"},
        "render_hash": {"$ref": "#/$defs/hash"},
        "viewport": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "objects", "region_or_anchor", "intent", "target", "owner"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "objects": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 1, "uniqueItems": true},
        "region_or_anchor": {"$ref": "#/$defs/text"},
        "intent": {"$ref": "#/$defs/text"},
        "target": {"type": "object", "minProperties": 1},
        "owner": {"$ref": "#/$defs/text"}
      }
    },
    "visual": {
      "type": "object", "additionalProperties": false,
      "required": ["view_receipt", "region", "observation", "status"],
      "properties": {
        "view_receipt": {"anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
        "region": {"$ref": "#/$defs/text"},
        "observation": {"$ref": "#/$defs/text"},
        "status": {"$ref": "#/$defs/laneStatus"}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "support", "units", "value", "tolerance", "receipt", "status"],
      "properties": {
        "metric": {"$ref": "#/$defs/text"},
        "support": {"enum": ["supported", "unsupported"]},
        "units": {"$ref": "#/$defs/text"},
        "value": {"type": ["number", "object", "array", "null"]},
        "tolerance": {"type": ["number", "null"], "minimum": 0},
        "receipt": {"anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
        "status": {"$ref": "#/$defs/laneStatus"}
      }
    },
    "verdict": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["pass", "fail", "unverified", "not-applicable", "disputed"]},
        "reason": {"$ref": "#/$defs/text"}
      }
    }
  }
}
